#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail
umask 077

config() { jq -er --arg key "$1" '.[$key] | select(type == "string")' /data/options.json; }
fail() { printf '%s\n' "$1" >&2; exit 1; }
server=$(config server)
if [[ -z "$server" || "$server" == -* || "$server" == *[[:space:]]* ]]; then
    fail 'Set server to the Music Assistant host or IP (optionally :port).'
    exit 1
fi

loglevel=$(config log_level)
case "$loglevel" in
    error) loglevel=error ;;
    warning) loglevel=warn ;;
    notice|info) loglevel=info ;;
    debug) loglevel=debug ;;
    trace) loglevel=sdebug ;;
    *) fail 'Invalid log level'; exit 1 ;;
esac

name=$(config name)
printf '%s\n' "$name" > /data/name

if jq -e '.clientmac != null and .clientmac != ""' /data/options.json > /dev/null; then
    clientmac=$(config clientmac)
else
    if [[ ! -s /data/mac ]]; then
        read -r random_hex < /proc/sys/kernel/random/uuid
        random_hex=${random_hex//-/}
        printf '02:%s:%s:%s:%s:%s\n' "${random_hex:0:2}" "${random_hex:2:2}" \
            "${random_hex:4:2}" "${random_hex:6:2}" "${random_hex:8:2}" > /data/mac
    fi
    clientmac=$(< /data/mac)
fi
if [[ ! "$clientmac" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
    fail 'clientmac must contain six colon-separated hexadecimal bytes.'
    exit 1
fi

# Use the output selected in the add-on's Home Assistant Audio panel.
# Explicit server addressing avoids host networking and broadcast discovery.
printf '%s\n' 'Starting Squeezelite using Home Assistant audio.'
exec /usr/local/bin/squeezelite -M SqueezeLite-HA-Addon -N /data/name \
    -s "$server" -m "$clientmac" -d "all=$loglevel"
